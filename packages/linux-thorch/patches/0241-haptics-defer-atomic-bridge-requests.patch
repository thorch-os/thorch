+/* Input playback/gain callbacks may hold event_lock: only this worker sleeps.
+ * Coalesce pending requests to the latest requested motor state.
+ */
+static void global_haptics_work_fn(struct work_struct *work)
+{
+	struct input_dev *dev;
+	unsigned long flags;
+	int id, value, ret = 0;
+	u16 gain;
+	bool play_pending, gain_pending;
+
+	mutex_lock(&global_haptics_lock);
+	spin_lock_irqsave(&global_haptics_request_lock, flags);
+	id = global_effect_id;
+	value = global_play_value;
+	gain = global_gain;
+	play_pending = global_play_pending;
+	gain_pending = global_gain_pending;
+	global_play_pending = global_gain_pending = false;
+	spin_unlock_irqrestore(&global_haptics_request_lock, flags);
+	if (global_haptics) {
+		dev = global_haptics->input_dev;
+		mutex_lock(&dev->ff->mutex);
+		if (gain_pending)
+			dev->ff->set_gain(dev, gain);
+		if (play_pending)
+			ret = value ? dev->ff->playback(dev, id, value) :
+				dev->ff->erase(dev, id);
+		mutex_unlock(&dev->ff->mutex);
+		if (ret)
+			dev_err_ratelimited(global_haptics->dev,
+				"asynchronous rumble request failed: %d\n", ret);
+	}
+	mutex_unlock(&global_haptics_lock);
+}
